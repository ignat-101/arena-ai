# === TON Trace — конфигурация ===
# Скопируйте в .env и заполните свои значения

# Порт и хост
PORT=8080
HOST=0.0.0.0

# Ключ TonAPI (https://tonapi.io/dashboard) — используется сервером для проксирования.
# Если оставить пустым, фронтенд будет ходить в TonAPI напрямую из браузера (без ключа, лимит ~1 rps).
TONAPI_KEY=AFFFNJMCYD2LUPIAAAAIGUX5DHIQXB7YXHREDALK2DNV4BZOWMNXD5EAADBSHA7KH7AX66Y

# ВАЖНО: если задать PUBLIC_TONAPI_KEY — ключ станет видимым в коде страницы (небезопасно, но быстро).
# Оставьте пустым, чтобы ключ не утекал в браузер.
PUBLIC_TONAPI_KEY=

# Мастер-код суперадмина (по нему регистрируется первый админ). Обязательно смените!
ADMIN_MASTER_CODE=trace-admin-2026

# Режим источника данных: backend (все запросы через сервер) | auto (браузер -> TonAPI напрямую, при сбое -> сервер)
DATA_SOURCE_MODE=auto

# Ограничения выборки событий
MAX_EVENTS_DEFAULT=1000
MAX_EVENTS_CAP=5000
