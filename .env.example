# ==============================================================================
# X.COM PREMIUM FUNPAY AUTOMATION v2.0 - КОНФИГУРАЦИОННЫЙ ФАЙЛ
# Полная автоматизация: авто-оплата в Base, AI-поддержка OpenRouter, Web-дашборд
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. НАСТРОЙКИ TELEGRAM БОТА (@BotFather)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz-1234567"
TELEGRAM_ADMIN_IDS="123456789"

# ------------------------------------------------------------------------------
# 2. НАСТРОЙКИ FUNPAY (GOLDEN KEY / COOKIE)
# ------------------------------------------------------------------------------
FUNPAY_GOLDEN_KEY=""
FUNPAY_USER_AGENT="Mozilla/53.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"
FUNPAY_POLL_INTERVAL=5
AUTO_RESPOND_FUNPAY=true

# ------------------------------------------------------------------------------
# 3. НАСТРОЙКИ AI-АССИСТЕНТА ПОДДЕРЖКИ (OPENROUTER API)
# ------------------------------------------------------------------------------
# Бесплатный API ключ OpenRouter (https://openrouter.ai)
# Если ключ не указан, работает встроенная база знаний для ответов покупателям
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Модель для генерации ответов (бесплатные модели OpenRouter)
# Примеры: google/gemini-2.0-flash-lite-preview-02-05:free, meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL="google/gemini-2.0-flash-lite-preview-02-05:free"

# ------------------------------------------------------------------------------
# 4. НАСТРОЙКИ АВТОМАТИЧЕСКОЙ ОПЛАТЫ В БЛОКЧЕЙНЕ (BASE ON-CHAIN PAYER)
# ------------------------------------------------------------------------------
# Полностью автоматизировать оплату без ручного сканирования QR-кода
AUTOMATIC_CRYPTO_PAYMENT=true

# Приватный ключ кошелька продавца в сети Base (0x...) для автоматической оплаты
# Внимание: для тестирования оставьте пустым или включите USE_MOCK_CRYPTO=true
SELLER_WALLET_PRIVATE_KEY=""

# RPC-адрес сети Base (по умолчанию официальный RPC Base Mainnet)
BASE_RPC_URL="https://mainnet.base.org"

# Использовать безопасный режим эмуляции ончейн-транзакций (без списания реальных средств)
USE_MOCK_CRYPTO=true

# ------------------------------------------------------------------------------
# 5. НАСТРОЙКИ ПОДПИСКИ X.COM (TWITTER PREMIUM)
# ------------------------------------------------------------------------------
X_SUBSCRIPTION_PLAN="premium"
X_SUBSCRIPTION_TIER="monthly"
BLOCKCHAIN_NETWORK="Base"
WALLET_TYPE="Trust Wallet"
CRYPTO_CURRENCY="ETH"

# ------------------------------------------------------------------------------
# 6. НАСТРОЙКИ WEB-ДАШБОРДА И СИМУЛЯТОРА
# ------------------------------------------------------------------------------
# Порт для работы Web-сервера и интерфейса тестирования
WEB_HOST="0.0.0.0"
WEB_PORT=8000

# ------------------------------------------------------------------------------
# 7. НАСТРОЙКИ БРАУЗЕРА PLAYWRIGHT И БД
# ------------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=false
BROWSER_TIMEOUT=60
USE_MOCK_FUNPAY=false
USE_MOCK_BROWSER=false
DATABASE_PATH="data/orders.db"
